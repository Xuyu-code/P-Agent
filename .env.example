# 河湟非遗知识问答与皮影创作 Agent · 环境变量示例
# 本项目不依赖 .env 加载库，请直接在 shell 中设置：
#   Windows PowerShell:  $env:LLM_API_KEY="sk-..."
#   bash / Linux:        export LLM_API_KEY=sk-...

# ---------------------------------------------------------------------------
# LLM（OpenAI 兼容接口；国内直连，二选一或自建）
# ---------------------------------------------------------------------------
# 通义千问 DashScope（默认 base_url）：
#   https://dashscope.aliyuncs.com/compatible-mode/v1
# Kimi（月之暗面）：
#   https://api.moonshot.cn/v1
#   注意：kimi-k2.6 等推理模型只允许 temperature=1（需设 LLM_TEMPERATURE=1）；
#   Moonshot 未开放 embeddings 接口，用 Kimi 时嵌入请选 EMBEDDING_PROVIDER=local。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-在这里填你的Key
LLM_MODEL=qwen-plus
# LLM_TIMEOUT=60
# LLM_TEMPERATURE=0.2

# ---------------------------------------------------------------------------
# 嵌入模型
# ---------------------------------------------------------------------------
# dashscope：走上面的同账号远程 API（默认，零本地依赖）
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
# local：BGE-small-zh 本地嵌入（需 pip install sentence-transformers；
# 首次下载走镜像：$env:HF_ENDPOINT="https://hf-mirror.com"）
# EMBEDDING_PROVIDER=local
# LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ---------------------------------------------------------------------------
# 外部图像生成服务（HTTP 调用）
# ---------------------------------------------------------------------------
PUPPET_API_BASE=http://localhost:8000
# PUPPET_SUBMIT_TIMEOUT=30
# PUPPET_POLL_INTERVAL=2
# PUPPET_POLL_TIMEOUT=300

# ---------------------------------------------------------------------------
# 检索
# ---------------------------------------------------------------------------
# RETRIEVAL_TOP_K=5
# RETRIEVAL_MAX_DISTANCE=0.55   # 余弦距离阈值，超过视为“无证据”
